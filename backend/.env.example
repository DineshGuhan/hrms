# Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hrms_dev
DATABASE_URL_TEST=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hrms_test

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Encryption of sensitive employee fields (FR-EMP-05); at least 32 chars
ENCRYPTION_KEY=change-me-to-another-long-random-string

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
